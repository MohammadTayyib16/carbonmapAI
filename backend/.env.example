# CarbonMap AI — Backend Environment Configuration Example
# Copy this file to .env and customize as needed. Do NOT commit the actual .env file.

# Application Environment
ENVIRONMENT=development
DEBUG=True
APP_NAME="CarbonMap AI"
VERSION="0.1.0"
API_V1_PREFIX="/api/v1"

# CORS configuration (comma-separated list of allowed origins)
ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# Database Configuration (PostgreSQL compatible with persistent SQLite fallback)
DATABASE_URL="sqlite:///./carbonmap.db"

# Server Host & Port
HOST="127.0.0.1"
PORT=8000

# Google Gemini AI API Configuration
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# OCR Configuration
OCR_ENGINE="tesseract"
